#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int t;
	cin>>t;
	while(t--){
	    int x;
	    cin>>x;
	    if(x>=7){
	        cout<<"heavy";
	    }
	    else if(x<3){
	        cout<<"light";
	    }
	    else{
	        cout<<"moderate";
	    }
	    cout<<endl;
	}

}
