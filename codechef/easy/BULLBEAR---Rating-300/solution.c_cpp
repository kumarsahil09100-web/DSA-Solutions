#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int t;
	cin>>t;
	while(t--){
	    int x,y;
	    cin>>x>>y;
	    if((y-x)>0){
	        cout<<"profit";
	    }
	    else if ((y-x)==0){
	        cout<<"neutral";
	    }
	    else{
	        cout<<"loss";
	    }
	    cout<<endl;
	}

}
