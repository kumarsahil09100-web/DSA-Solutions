#include <bits/stdc++.h>


using namespace std;

int main() {
    int T;
    cin >> T;

    while (T--) {
        int N;
        string A, B;

        cin >> N;
        cin >> A >> B;

        int onesA = 0, onesB = 0;

        for (char c : A) {
            if (c == '1')
                onesA++;
        }

        for (char c : B) {
            if (c == '1')
                onesB++;
        }

        if (onesA % 2 == onesB % 2)
            cout << "YES\n";
        else
            cout << "NO\n";
    }



}
